set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KINDLE_TOOLCHAIN KINDLE_SYSROOT)
set(KINDLE_TOOLCHAIN "$ENV{KINDLE_TOOLCHAIN}" CACHE PATH "Kindle compiler directory")
set(KINDLE_SYSROOT "$ENV{KINDLE_SYSROOT}" CACHE PATH "Kindle ARM sysroot")
if(NOT KINDLE_TOOLCHAIN OR NOT KINDLE_SYSROOT)
  message(FATAL_ERROR "Set KINDLE_TOOLCHAIN (compiler prefix directory) and KINDLE_SYSROOT (ARM hard-float sysroot)")
endif()
set(CMAKE_C_COMPILER "${KINDLE_TOOLCHAIN}/bin/arm-kindlehf-linux-gnueabihf-gcc")
set(CMAKE_CXX_COMPILER "${KINDLE_TOOLCHAIN}/bin/arm-kindlehf-linux-gnueabihf-g++")
set(CMAKE_SYSROOT "${KINDLE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Debian multiarch sysroot for the self-contained experimental release.
# A firmware SDK with libraries in /usr/lib also works with these search paths.
set(CMAKE_C_FLAGS_INIT "-B${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf/ -march=armv7-a -mfpu=neon -mfloat-abi=hard -I${CMAKE_SYSROOT}/usr/include/arm-linux-gnueabihf")
set(CMAKE_CXX_FLAGS_INIT "-B${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf/ -march=armv7-a -mfpu=neon -mfloat-abi=hard -I${CMAKE_SYSROOT}/usr/include/arm-linux-gnueabihf")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf -L${CMAKE_SYSROOT}/lib/arm-linux-gnueabihf -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf:${CMAKE_SYSROOT}/lib/arm-linux-gnueabihf")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf/pkgconfig:${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
